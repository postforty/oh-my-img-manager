{
  "manifest_version": 3,
  "name": "Oh My Image Manager - 스마트 이미지 크롭 & 배경 제거(누끼) 스튜디오",
  "version": "1.1.0",
  "description": "대용량 이미지 일괄 크롭 & ZIP 압축 및 온디바이스 AI 기반 실시간 배경 제거(누끼 따기)를 지원하는 스마트 이미지 매니저입니다.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Oh My Image Manager"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "clipboardWrite"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*",
        "lib/transformers/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
